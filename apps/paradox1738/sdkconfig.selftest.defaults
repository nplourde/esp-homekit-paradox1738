# Overlay for the link self-test build (T1.6).
#
#   idf.py -B build-selftest \
#       -D SDKCONFIG=sdkconfig.selftest \
#       -D SDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.selftest.defaults" build
#
# Use `make build-selftest` from the repo root. app_main() then calls
# paradox1738_link_selftest(), which inits the link, calls paradox1738_deinit()
# twice and re-inits. Look for "LINK SELFTEST: PASS" in the boot log.
CONFIG_PARADOX_LINK_SELFTEST=y
