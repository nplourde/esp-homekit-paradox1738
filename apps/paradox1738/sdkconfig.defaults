CONFIG_APP_WIFI_USE_PROVISIONING=y
CONFIG_APP_WIFI_USE_UNIFIED_PROVISIONING=y
CONFIG_APP_WIFI_PROV_TRANSPORT_BLE=y
CONFIG_HAP_HTTP_SERVER_PORT=8080
CONFIG_BT_ENABLED=y
